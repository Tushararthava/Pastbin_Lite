{
    "version": 2,
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/styles.css",
            "dest": "/dist/public/styles.css"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/api/index.js"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}