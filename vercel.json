{
    "version": 2,
    "builds": [
        {
            "src": "backend/api/index.ts",
            "use": "@vercel/node"
        },
        {
            "src": "backend/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/api/index.ts"
        },
        {
            "src": "/p/(.*)",
            "dest": "backend/api/index.ts"
        },
        {
            "src": "/login",
            "dest": "backend/public/login.html"
        },
        {
            "src": "/register",
            "dest": "backend/public/register.html"
        },
        {
            "src": "/(.*)",
            "dest": "backend/public/$1"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}