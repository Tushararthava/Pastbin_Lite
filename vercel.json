{
    "version": 2,
    "builds": [
        {
            "src": "backend/package.json",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "backend/dist/**",
                    "backend/public/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/dist/api/index.js"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}